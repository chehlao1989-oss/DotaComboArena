config_version=5

[application]
config/name="Dota Combo Arena"
config/version="0.6.6"
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07058824, 0.09411765, 0.10588235, 1)
boot_splash/minimum_display_time=0
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1100
window/size/min_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.067, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
